# htm: nested spherical triangles; a name prefix is an area, its id range the whole subtree.
# Render: d2 docs/htm.d2 docs/htm.svg
vars: { d2-config: { layout-engine: elk; theme-id: 302; sketch: true; pad: 24; theme-overrides: { B1: "#8C7B7E"; B2: "#C25B73"; N2: "#C25B73" } } }
style.fill: transparent

direction: right

s: "trixel S" {
  label.near: top-left
  s1: "trixel S1" {
    label.near: top-left
    s13: "trixel S13" {
      label.near: top-left
      leaf: "Sydney's trixel\nS1301…301131" {
        width: 220
        height: 150
      }
    }
  }
}

range: "getRange(\"S13\")\nids [start, end]\nof every descendant"

s.s1.s13 -> range
